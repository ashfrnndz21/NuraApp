{
  "name": "nura-web",
  "private": true,
  "version": "0.1.0",
  "description": "Nura's web client (ADR 0001): the app the patient opens in Safari and adds to the home screen.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "plain-words": "cd ../backend && python3 -m app.safety.plain_words --only ../web/src/strings/en.ts ../web/src/strings/ms.ts ../web/src/strings/zh.ts ../web/src/api/mock/words.ts ../web/src/api/mock/graph.ts"
  },
  "dependencies": {
    "@preact/signals": "2.11.2",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
